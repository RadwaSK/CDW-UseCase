# Single env file for local development and tests. For a real deployment,
# replace these values with the production ones (nothing else changes).
APP_ENV=development

# Must contain "test" (or set TEST_DB=true) or the test suite refuses to run,
# so a production URL here can never be wiped by a stray pytest invocation.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/multi_agent_repo_reviewer_test

# Choose azure_openai or openai
LLM_PROVIDER=azure_openai

# Azure OpenAI (preferred)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# LangSmith observability (docs/architecture.md -> "LangSmith observability").
#   - Used for local demo / development runs only. Set LANGSMITH_TRACING=true and
#     paste a personal key to send LangGraph + Azure OpenAI traces to LangSmith.
#   - The test suite and the offline evaluation force tracing OFF regardless of
#     this value, so CI never needs a key and never emits traces.
#   - The API key is a personal secret: keep it in your local .env (git-ignored),
#     never commit it, never put it in this example file.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-repo-reviewer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Set true to skip real Azure embedding calls (tests always force this on)
USE_FAKE_EMBEDDINGS=true

# Set true to use deterministic rule-based agents instead of live chat-model
# calls (tests always force this on).
USE_FAKE_LLM=true

# Embedding configuration: must match the deployed model's output dimension.
# text-embedding-3-small and ada-002 use 1536; text-embedding-3-large uses 3072.
EMBEDDING_DIMENSION=1536

# RAG tuning (rarely changed):
RETRIEVAL_TOP_K=6
MAX_REVISIONS=1
SAMPLE_DATA_DIR=sample_data
